{
    "name": "intellect-web-development/symfony-doctrine-search-bundle",
    "description": "Search through Doctrine entities via the HTTP API: filters, constraints, sorting and pagination",
    "type": "symfony-bundle",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/intellect-web-development/symfony-doctrine-search-bundle/issues"
    },
    "authors": [
        {
            "name": "alexander.erin",
            "email": "sanyaerin@mail.ru"
        }
    ],
    "autoload": {
        "psr-4": {
            "IWD\\SymfonyDoctrineSearch\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IWD\\SymfonyDoctrineSearch\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.4",
        "ext-mbstring": "*",
        "doctrine/dbal": "^4.0",
        "doctrine/orm": "^3.3",
        "doctrine/persistence": "^3.0 || ^4.0",
        "symfony/config": "^7.3 || ^8.0",
        "symfony/dependency-injection": "^7.3 || ^8.0",
        "symfony/http-foundation": "^7.3 || ^8.0",
        "symfony/http-kernel": "^7.3 || ^8.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.0",
        "symfony/cache": "^7.3 || ^8.0",
        "zircote/swagger-php": "^5.0"
    },
    "suggest": {
        "zircote/swagger-php": "OpenAPI attributes on OutputPagination and SearchQueryParameters"
    },
    "config": {
        "sort-packages": true
    }
}
